# Small runtime; keep large SDK virtualenv on a caller-selected data volume.
FROM python:3.10-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370
RUN apt-get update && apt-get install -y --no-install-recommends libglu1-mesa libgl1 libxrender1 libxkbcommon0 libegl1 && rm -rf /var/lib/apt/lists/*
ENV OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 TF_CPP_MIN_LOG_LEVEL=2
WORKDIR /work
ENTRYPOINT ["/env/bin/python"]
